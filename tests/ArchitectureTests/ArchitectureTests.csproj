<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Override in CI: dotnet test -p:AssignmentRoot=<path to ai-in-sdlc-assignment> -->
    <AssignmentRoot Condition="'$(AssignmentRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\ai-in-sdlc-assignment</AssignmentRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(AssignmentRoot)\backend\src\InvoiceApp.Api\InvoiceApp.Api.csproj" />
  </ItemGroup>
</Project>
